class Solution {
    public ArrayList<Integer> leftView(Node root) {
      ArrayList<Integer> list = new ArrayList<>();
        if (root == null)
            return list;

        Queue<Node> q = new LinkedList<>();
        q.offer(root);

        while (!q.isEmpty()) {
          int size = q.size();
      for (int i = 0; i < size; i++) {
   
            Node curr = q.poll();

                if (i == 0)
                    list.add(curr.data);

                if (curr.left != null)
                    q.offer(curr.left);

                if (curr.right != null)
                    q.offer(curr.right);
            }
        }

        return list;
    }
}
